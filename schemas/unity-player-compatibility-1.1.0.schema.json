{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/unity-player-compatibility-1.1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unityVersion", "testFrameworkVersion", "allowedSourceKind", "registryOrigin",
          "unityExecutableSha256", "packageTreeSha256", "packageHashCanonicalization",
          "target", "scriptingBackend", "windowsModuleTreeSha256", "moduleHashCanonicalization",
          "toolchainIdentitySha256", "visualStudioVersion", "msvcVersion", "windowsSdkVersion",
          "minimumPhase", "status", "evidencePath"
        ],
        "properties": {
          "unityVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[abfp][0-9]+$" },
          "testFrameworkVersion": { "type": "string", "minLength": 1 },
          "allowedSourceKind": { "enum": ["registry", "builtin"] },
          "registryOrigin": { "type": ["string", "null"] },
          "unityExecutableSha256": { "$ref": "#/definitions/sha256" },
          "packageTreeSha256": { "$ref": "#/definitions/sha256" },
          "packageHashCanonicalization": { "const": "upv-package-tree-relative-path-length-sha256-lf-v1" },
          "target": { "const": "StandaloneWindows64" },
          "scriptingBackend": { "enum": ["Mono", "IL2CPP"] },
          "windowsModuleTreeSha256": { "$ref": "#/definitions/sha256" },
          "moduleHashCanonicalization": { "const": "upvr-tree-relative-path-length-sha256-lf-v1" },
          "toolchainIdentitySha256": { "anyOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] },
          "visualStudioVersion": { "type": ["string", "null"] },
          "msvcVersion": { "type": ["string", "null"] },
          "windowsSdkVersion": { "type": ["string", "null"] },
          "minimumPhase": { "enum": ["P1", "P2", "P3"] },
          "status": { "enum": ["CANDIDATE", "APPROVED", "RETIRED"] },
          "evidencePath": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "scriptingBackend": { "const": "IL2CPP" } } },
            "then": {
              "properties": {
                "toolchainIdentitySha256": { "$ref": "#/definitions/sha256" },
                "visualStudioVersion": { "type": "string", "minLength": 1 },
                "msvcVersion": { "type": "string", "minLength": 1 },
                "windowsSdkVersion": { "type": "string", "minLength": 1 }
              }
            },
            "else": {
              "properties": {
                "toolchainIdentitySha256": { "type": "null" },
                "visualStudioVersion": { "type": "null" },
                "msvcVersion": { "type": "null" },
                "windowsSdkVersion": { "type": "null" }
              }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
